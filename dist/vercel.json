{
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/home/?$",
      "status": 307,
      "headers": { "Location": "/" }
    },
    {
      "src": "^/pages/home(\\.html)?/?$",
      "status": 307,
      "headers": { "Location": "/" }
    },
    {
      "src": "^/(dang_nhap|dang-nhap|login)/?$",
      "status": 307,
      "headers": { "Location": "/pages/index" }
    }
  ]
}
