{
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/(llms|llms-full).txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"alternate\"; type=\"text/plain\", <https://baoddc.com/>; rel=\"canonical\"" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pages/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pages/home.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pages/trang-chu/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pages/trang-chu/home.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pages/vi-tri-ton",
      "destination": "/pages/tem-nhan-kiem-ke/vi-tri-ton.html",
      "permanent": false
    },
    {
      "source": "/pages/vi-tri-ton.html",
      "destination": "/pages/tem-nhan-kiem-ke/vi-tri-ton.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pages/trang-chu/home.html",
      "destination": "/index.html"
    },
    {
      "source": "/pages/trang-chu/home",
      "destination": "/index.html"
    },
    {
      "source": "/pages/home.html",
      "destination": "/index.html"
    },
    {
      "source": "/pages/home",
      "destination": "/index.html"
    },
    {
      "source": "/home.html",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
